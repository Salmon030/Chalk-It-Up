{
  "name": "chalk-it-up",
  "version": "1.0.0",
  "description": "Chalk It Up! - draw it, print it, play with it",
  "author": "Chalk It Up",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.chalkitup.game",
    "productName": "Chalk It Up",
    "files": ["main.js", "preload.js", "index.html", "build/icon.png", "assets/**"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "category": "public.app-category.games" },
    "linux": { "target": "AppImage", "category": "Game" }
  }
}
